            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"teacher001\",\n    \"password\": \"password123\",\n    \"real_name\": \"李四\",\n    \"email\": \"teacher001@example.com\",\n    \"phone\": \"13900139001\",\n    \"user_type\": 1,\n    \"teacher_id\": \"T2025001\",\n    \"title\": \"教授\",\n    \"department\": \"计算机学院\",\n    \"office\": \"科技楼A401\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
