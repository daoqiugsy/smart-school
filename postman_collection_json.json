    {
      "name": "AI Assistant",
      "description": "Endpoints for interacting with the AI assistant. Requires authentication.",
      "item": [
        {
          "name": "Chat with AI",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "text/event-stream"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"query\": \"你好，请介绍一下你自己。\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/schedule/ai/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "schedule",
                "ai",
                "chat"
              ]
            },
            "description": "Sends a query to the AI assistant. This endpoint provides a streaming response (Server-Sent Events). Postman can handle and display SSE streams."
          },
          "response": []
        }
      ]
    }
