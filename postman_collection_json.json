  "item": [
    {
      "name": "Authentication",
      "description": "User registration and login endpoints.",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"username\": \"student001\",\n    \"password\": \"password123\",\n    \"real_name\": \"张三\",\n    \"email\": \"student001@example.com\",\n    \"phone\": \"13800138001\",\n    \"user_type\": 0,\n    \"student_id\": \"S2025001\",\n    \"grade\": \"2025\",\n    \"class\": \"软件工程1班\",\n    \"major\": \"软件工程\",\n    \"department\": \"计算机学院\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "description": "Registers a new user with the type 'Student' (user_type: 0)."
          },
          "response": []
        },
        {
          "name": "Register Teacher",
